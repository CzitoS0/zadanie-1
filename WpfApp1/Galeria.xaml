<Window x:Class="TestRefleksu.Galeria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galeria"
        Height="650"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#171923">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GALERIA Mocarstw"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>


        <UniformGrid Grid.Row="1"
                     Columns="2"
                     Rows="2"
                     Margin="0,5">

            <Border Background="#252936"
                    CornerRadius="10"
                    Margin="6"
                    Padding="8">
                <StackPanel>
                    <Image Source="cobyszrobil.png"
                           Stretch="Uniform"
                           Height="190"/>
                    <TextBlock Text="Mamon XD"
                               Foreground="White"
                               FontSize="16"
                               />
                </StackPanel>
            </Border>

            <Border Background="#252936"
                    CornerRadius="10"
                    Margin="6"
                    Padding="8">
                <StackPanel>
                    <Image Source="dawidjasper.png"
                           Stretch="Uniform"
                           Height="190"/>
                    <TextBlock Text="Dawidek"
                               Foreground="White"
                               FontSize="16"
                               />
                </StackPanel>
            </Border>

            <Border Background="#252936"
                    CornerRadius="10"
                    Margin="6"
                    Padding="8">
                <StackPanel>
                    <Image Source="/dawidek.png"
                           Stretch="Uniform"
                           Height="190" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="0.435"/>
                                <RotateTransform/>
                                <TranslateTransform X="0.721"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="Dawidek2"
                               Foreground="White"
                               FontSize="16"
                               />
                </StackPanel>
            </Border>

            <Border Background="#252936"
                    CornerRadius="10"
                    Margin="6"
                    Padding="8">
                <StackPanel>
                    <Image Source="/mamon2.jpg"
                           Stretch="Uniform"
                           Height="190"/>
                    <TextBlock Text="mamon 2"
                               Foreground="White"
                               FontSize="16"
                               />
                </StackPanel>
            </Border>

        </UniformGrid>

        <Button Grid.Row="2"
                Content="WROC DO TESTU"
                Height="42"
                Width="200"
                FontSize="16"
                Background="#7457E8"
                Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"
                Click="Wroc_Click"/>

    </Grid>
</Window>

<Window x:Class="TestRefleksu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite legends"
        Height="600"
        Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#171923">

    <StackPanel Margin="25"
                VerticalAlignment="Center">

        <TextBlock Text="TEST REFLEKSU"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock x:Name="Instrukcja"
                   Text="Kliknij Ciastek i czekaj na zielony kolor"
                   Foreground="White"
                   FontSize="15"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,15"/>

        <Button x:Name="Pole"
                Content="Ciastek"
                Height="100"
                FontSize="25"
                FontWeight="Bold"
                Background="#E34D58"
                Foreground="White"
                Click="Pole_Click"/>

        <TextBlock x:Name="Wynik"
                   Text="Twoj czas: --- ms"
                   Foreground="White"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   Margin="0,20"/>

        <Image x:Name="SlabyObraz"
               Source="cobyszrobil.png"
               Width="180"
               Height="120"
               Stretch="Uniform"
               Visibility="Collapsed"
               Margin="0,0,0,10"/>

        <Button x:Name="StartButton"
                Content="START"
                Height="45"
                FontSize="18"
                Background="#7457E8"
                Foreground="White"
                Click="StartButton_Click"/>

        <Button Content="GALERIA"
                Height="45"
                FontSize="18"
                Background="#258B58"
                Foreground="White"
                Margin="0,12,0,0"
                Click="Galeria_Click"/>

        <Button Content="a se kliknij"
        Height="30"
        Width="110"
        FontSize="12"
        Background="#343849"
        Foreground="White"
        HorizontalAlignment="Right"
        Margin="0,5,0,0"
        Click="Fullscreen_Click"/>

    </StackPanel>
</Window>
